#include "xhb.ch"
#include "common.ch"
#include "hbclass.ch"

#translate ( <exp1> | <exp2> )      => ( hb_qbitOr( ( <exp1> ), ( <exp2> ) ) )
#translate ( <exp1> & <exp2> )      => ( hb_qbitAnd( ( <exp1> ), ( <exp2> ) ) )
#translate ( <exp1> ^^ <exp2> )     => ( hb_qbitXor( ( <exp1> ), ( <exp2> ) ) )

#include "d_textur.ch"

CLASS pic_t
    DATA width
    DATA height
    DATA data
    METHOD New()
ENDCLASS

METHOD New() CLASS pic_t
    ::width  := 0
    ::height := 0
    ::data   := 0
RETURN Self
