#include "xhb.ch"
#include "common.ch"
#include "hbclass.ch"

#translate ( <exp1> | <exp2> )      => ( hb_qbitOr( ( <exp1> ), ( <exp2> ) ) )
#translate ( <exp1> & <exp2> )      => ( hb_qbitAnd( ( <exp1> ), ( <exp2> ) ) )
#translate ( <exp1> ^^ <exp2> )     => ( hb_qbitXor( ( <exp1> ), ( <exp2> ) ) )

#include "w_checksum.ch"

PROCEDURE W_Checksum( digest )
    LOCAL i

    IF ValType( digest ) == "A"
        FOR i := 1 TO 20
            IF i <= Len( digest )
                digest[ i ] := 0
            ELSE
                AAdd( digest, 0 )
            ENDIF
        NEXT
    ENDIF
RETURN
